{
  "name": "vietnam-economic-newsletter-dashboard",
  "version": "1.0.0",
  "description": "Vietnam economic newsletter dashboard with GitHub Actions data collection, duplicate removal, and OpenAI summaries.",
  "type": "module",
  "scripts": {
    "sync:exclusions": "node scripts/sync-exclusions.js",
    "fetch": "node scripts/fetch-news.js",
    "fetch:sns": "node scripts/fetch-sns.js",
    "test": "node --test scripts/*.test.js",
    "test:youtube-filter": "node --test scripts/youtube-filter.test.js",
    "validate:data": "node scripts/validate-output.js all",
    "validate:bcgland": "node scripts/validate-output.js bcgland",
    "serve": "python -m http.server 8000"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.0.0",
    "jsdom": "^24.1.3",
    "openai": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
